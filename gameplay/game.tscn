[sub_resource type="RectangleShape2D" id="RectangleShape2D_left_wall"]

[sub_resource type="RectangleShape2D" id="RectangleShape2D_right_wall"]

[sub_resource type="RectangleShape2D" id="RectangleShape2D_top_wall"]

[node name="Game" type="Node2D"]
process_mode = 3
script = ExtResource("1_game")
level_list = ExtResource("2_level_list")

[node name="Backdrop" type="CanvasLayer" parent="."]
layer = -1

[node name="Fill" type="ColorRect" parent="Backdrop"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.08, 0.19, 0.1, 1)

[node name="Background" type="Node2D" parent="." node_paths=PackedStringArray("playfield")]
script = ExtResource("3_background")
playfield = NodePath("../Playfield")

[node name="Playfield" type="Node2D" parent="."]
process_mode = 1
script = ExtResource("7_playfield")

[node name="Walls" type="StaticBody2D" parent="Playfield"]
collision_mask = 0

[node name="Left" type="CollisionShape2D" parent="Playfield/Walls"]
shape = SubResource("RectangleShape2D_left_wall")

[node name="Right" type="CollisionShape2D" parent="Playfield/Walls"]
shape = SubResource("RectangleShape2D_right_wall")

[node name="Top" type="CollisionShape2D" parent="Playfield/Walls"]
